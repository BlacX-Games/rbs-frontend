# Copy to `.env` (gitignored) and adjust. Nothing here is required — every var
# has a working local-development default, and Phase 0 consumes none of them
# beyond proving they validate.

# ─── API (Phase 2 — the API client; Phase 5 — first live data) ─────────────
# Base URL the API client prefixes onto `/admin/v1/...`. Leave EMPTY for
# same-origin, which in dev means the proxy below forwards to rbs-backend.
# Set an absolute origin (no trailing slash — validated) for a deployed build.
VITE_API_BASE_URL=

# Serve the MSW mock network instead of a real backend. Stays `true` until the
# Live Ops module flips to live data in Phase 5. Literal `true` or `false`.
VITE_USE_MOCKS=true

# ─── Dev server (Phase 0, dev only — never read by the app) ────────────────
# Where `vite dev` forwards `/admin/*`. Talking to the backend same-origin is
# what makes dev work before that repo's Phase 3 adds CORS middleware.
VITE_DEV_PROXY_TARGET=http://localhost:3000
