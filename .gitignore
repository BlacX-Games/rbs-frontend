# Idea
.idea/

# Docs — the GDD and plan at the repo root only. Anchored with a leading slash:
# a bare `docs/` matches any directory named `docs` at any depth, which would
# silently swallow a future `src/docs/`.
/docs/

# Generated by @tanstack/router-plugin from src/routes/**. Untracked so it
# cannot go stale against the route files it is derived from — the plugin
# rebuilds it on `dev` and on `build`, and a committed copy would show up as a
# diff on every branch that adds a route. Same reasoning as rbs-backend's
# gitignored openapi.json.
/src/routeTree.gen.ts
